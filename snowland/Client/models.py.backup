from django.db import models
from django.contrib.auth.models import User


class Client(models.Model):
    """
    客戶/平台模型
    代表使用本系統的不同客戶（例如：雪域創遊、其他滑雪學校等）
    """
    name = models.CharField(max_length=200, unique=True, verbose_name='客戶名稱')
    internal_code = models.CharField(
        max_length=50,
        unique=True,
        verbose_name='內部代碼',
        help_text='用於系統內部識別的唯一代碼'
    )

    # 聯絡資訊
    contact_person = models.CharField(max_length=100, blank=True, verbose_name='聯絡人')
    contact_email = models.EmailField(blank=True, verbose_name='聯絡Email')
    contact_phone = models.CharField(max_length=20, blank=True, verbose_name='聯絡電話')

    # 地址資訊
    address = models.TextField(blank=True, verbose_name='地址')

    # 狀態
    is_active = models.BooleanField(default=True, verbose_name='是否啟用')

    # 設定
    settings = models.JSONField(
        default=dict,
        blank=True,
        verbose_name='客戶設定',
        help_text='存放客戶特定的設定（如品牌顏色、Logo URL等）'
    )

    # 時間戳記
    created_at = models.DateTimeField(auto_now_add=True, verbose_name='建立時間')
    updated_at = models.DateTimeField(auto_now=True, verbose_name='更新時間')

    # 關聯管理員
    admin_users = models.ManyToManyField(
        User,
        blank=True,
        related_name='managed_clients',
        verbose_name='管理員帳號'
    )

    class Meta:
        verbose_name = '客戶'
        verbose_name_plural = '客戶管理'
        ordering = ['name']

    def __str__(self):
        return self.name
