# SnowLand AI customer service
# Create a new key after revoking any key that has appeared in chat or source control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_MAX_TOOL_ROUNDS=16
OPENAI_MAX_CONTEXT_MESSAGES=24

# LINE Messaging API
# Never reuse credentials that have appeared in chat, tickets, or source control.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CLIENT_CODE=snowland
LINE_API_TIMEOUT_SECONDS=10
LINE_LOADING_SECONDS=60
LINE_SESSION_TTL_DAYS=30
LINE_WEBHOOK_MAX_BODY_BYTES=1048576

# Public frontend payment page used in shared-class-ready and member payment emails.
# Set this to the deployed SnowLand frontend URL before enabling production payment mail.
# Only the loopback test_snowland database defaults to http://127.0.0.1:3000/snowland/payment.
# Example: https://your-snowland-domain.example/snowland/payment
SNOWLAND_PUBLIC_PAYMENT_URL=

# Private course files: use a persistent, backed-up folder outside public web roots.
# No public static/media route may serve this directory.
SNOWLAND_PRIVATE_COURSE_MEDIA_ROOT=
SNOWLAND_COURSE_MEDIA_MAX_PHOTO_BYTES=20971520
SNOWLAND_COURSE_MEDIA_MAX_VIDEO_BYTES=104857600
# Email: use environment settings, never commit a mailbox password.
# For local QA only: EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real delivery, set EMAIL_HOST / EMAIL_PORT / EMAIL_HOST_USER / EMAIL_HOST_PASSWORD.
# Set EMAIL_USE_TLS=1 for STARTTLS, or EMAIL_USE_SSL=1 for SSL (not both).
# Set DEFAULT_FROM_EMAIL to the approved sender. No credentials are included here.
